{
	"title": "Odin",
	"rules": [
		{
			"description": "Double-tap right command to open Odin",
			"manipulators": [
				{
					"type": "basic",
					"conditions": [
						{
							"type": "variable_if",
							"name": "odin_right_command_tapped",
							"value": 1
						}
					],
					"from": {
						"key_code": "right_command",
						"modifiers": { "optional": ["any"] }
					},
					"to": [{ "key_code": "right_command" }],
					"to_if_alone": [{ "shell_command": "open -a 'Odin Dev'" }]
				},
				{
					"type": "basic",
					"from": {
						"key_code": "right_command",
						"modifiers": { "optional": ["any"] }
					},
					"to": [
						{
							"set_variable": {
								"name": "odin_right_command_tapped",
								"value": 1
							}
						},
						{ "key_code": "right_command" }
					],
					"to_delayed_action": {
						"to_if_invoked": [
							{
								"set_variable": {
									"name": "odin_right_command_tapped",
									"value": 0
								}
							}
						],
						"to_if_canceled": [
							{
								"set_variable": {
									"name": "odin_right_command_tapped",
									"value": 0
								}
							}
						]
					}
				}
			]
		}
	]
}
