diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 2c0bd2d3..9d850edd 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,7 +1,7 @@
 # Every PR and every push to main: lint, typecheck, the unit and integration
 # suites, the app build, then a smoke test that boots the built app in a
 # throwaway home and clicks through its main flows (apps/desktop/scripts/smoke.ts).
-# Four jobs run side by side, so a run takes as long as the app build and
+# Five jobs run side by side, so a run takes as long as the app build and
 # smoke, not the sum of every step.
 name: CI
 
@@ -113,11 +113,52 @@ jobs:
           path: ${{ runner.temp }}/smoke
           if-no-files-found: ignore
 
+  # The Android app (apps/mobile/android): builds the debug APK, then pairs it
+  # in an emulator with fake-odin through the odin://pair link and waits for
+  # the board (apps/mobile/scripts/android-test.sh). Linux runners have KVM.
+  android:
+    runs-on: ubuntu-latest
+    timeout-minutes: 40
+    env:
+      SKIP_ENV_VALIDATION: "true"
+    steps:
+      - uses: actions/checkout@v5
+      - uses: ./.github/actions/setup
+
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "21"
+
+      - working-directory: apps/mobile
+        run: bun run android
+
+      - name: Enable KVM
+        run: |
+          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+          sudo udevadm control --reload-rules
+          sudo udevadm trigger --name-match=kvm
+
+      - uses: reactivecircus/android-emulator-runner@v2
+        with:
+          api-level: 34
+          target: google_apis
+          arch: x86_64
+          disable-animations: true
+          script: cd apps/mobile && bun run android:test
+
+      - if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: android
+          path: ${{ runner.temp }}/android
+          if-no-files-found: ignore
+
   # Branch protection requires one check named `check`. It passes only when all
-  # four jobs passed: a skipped required check would count as green.
+  # five jobs passed: a skipped required check would count as green.
   check:
     if: always()
-    needs: [static, test, app, windows]
+    needs: [static, test, app, windows, android]
     runs-on: ubuntu-latest
     steps:
       - run: ${{ !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') && !contains(needs.*.result, 'skipped') }}
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 0e34c3d1..89296fb7 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -243,3 +243,53 @@ jobs:
         with:
           name: Odin-Setup-x64
           path: apps/desktop/release/Odin-Setup-x64.exe
+
+  # Odin.apk, the Android app (apps/mobile/android), on the same release.
+  # Settings > Phone links /releases/latest/download/Odin.apk, so the asset
+  # name has to stay exactly that. Signed with ODIN_ANDROID_KEYSTORE (a base64
+  # PKCS12 file, alias "odin") and ODIN_ANDROID_KEYSTORE_PASSWORD: every
+  # release needs that same key, or Android won't install it over the last one.
+  android:
+    needs: macos
+    if: github.repository == 'danlinenberg/odin' && needs.macos.result == 'success' && !inputs.private
+    runs-on: ubuntu-latest
+    environment: release
+    timeout-minutes: 30
+    env:
+      SKIP_ENV_VALIDATION: "true"
+      TAG: ${{ needs.macos.outputs.tag }}
+    steps:
+      - uses: actions/checkout@v5
+      - uses: ./.github/actions/setup
+
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "21"
+
+      - name: Build Odin.apk
+        working-directory: apps/mobile
+        env:
+          KEYSTORE_BASE64: ${{ secrets.ODIN_ANDROID_KEYSTORE }}
+          ODIN_KEYSTORE_PASSWORD: ${{ secrets.ODIN_ANDROID_KEYSTORE_PASSWORD }}
+        run: |
+          set -euo pipefail
+          if [[ -z "$KEYSTORE_BASE64" || -z "$ODIN_KEYSTORE_PASSWORD" ]]; then
+            echo "::warning::No ODIN_ANDROID_KEYSTORE secrets: this release has no Odin.apk"
+            exit 0
+          fi
+          export ODIN_KEYSTORE="$RUNNER_TEMP/odin.p12"
+          base64 -d <<<"$KEYSTORE_BASE64" > "$ODIN_KEYSTORE"
+          # 1.4.12 -> 10412, and up with every release, as Android requires.
+          V="${TAG#v}"
+          export ODIN_VERSION_NAME="$V"
+          export ODIN_VERSION_CODE=$(awk -F. '{print $1*10000 + $2*100 + $3}' <<<"${V%%-*}")
+          bun run build
+          bunx cap sync android
+          (cd android && ./gradlew assembleRelease)
+          mv android/app/build/outputs/apk/release/app-release.apk Odin.apk
+
+      - if: hashFiles('apps/mobile/Odin.apk') != ''
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: gh release upload "$TAG" apps/mobile/Odin.apk
